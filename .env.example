GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Optional Auth.js alias for NEXTAUTH_SECRET
AUTH_SECRET=
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
RESEND_API_KEY=
RESEND_FROM_EMAIL=Job Finder Agent <onboarding@resend.dev>
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Prefer this name locally. On Vercel Blob, if the store was named
# BLOB_READ_WRITE_TOKEN, the token may appear as:
# BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN (also accepted by the app).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Morning cron always refreshes every complete user's feed at 6:00 AM IST.
# Email digests stay off until you set this to true (B-phase).
DIGEST_EMAILS_ENABLED=false
